# Web search backends (Hermes-compatible; first available wins if web.backend unset)
# DOUBAO_SEARCH_API_KEY=your-doubao-search-api-key  # 豆包搜索控制台 Key（非方舟 Ark）
# DOUBAO_SEARCH_BASE_URL=https://open.feedcoopapi.com/search_api/web_search
# BOCHA_API_KEY=your-bocha-api-key  # 博查 https://open.bochaai.com/
# BOCHA_SEARCH_BASE_URL=https://api.bochaai.com/v1/web-search
# TAVILY_API_KEY=your-tavily-api-key
# INFOQUEST_API_KEY=your-infoquest-api-key
# FIRECRAWL_API_KEY=your-firecrawl-api-key
# FIRECRAWL_API_URL=https://your-self-hosted-firecrawl
# BRAVE_SEARCH_API_KEY=your-brave-search-api-key
# SEARXNG_URL=http://localhost:8080
# ddgs needs no key (pip install ddgs) — free fallback

# Jina API Key (web_fetch)
JINA_API_KEY=your-jina-api-key

# CORS Origins (comma-separated) - e.g., http://localhost:3000,http://localhost:3001
# CORS_ORIGINS=http://localhost:3000

# Optional:
# Optional media generation (configure in EvoFlow Settings → Models → Creative Media):
# VOLCENGINE_API_KEY=your-volcengine-api-key
# ARK_API_KEY=your-volcengine-api-key
# AGNES_API_KEY=your-agnes-api-key
# OPENAI_API_KEY=your-openai-api-key
# GEMINI_API_KEY=your-gemini-api-key
# DEEPSEEK_API_KEY=your-deepseek-api-key
# NOVITA_API_KEY=your-novita-api-key  # OpenAI-compatible, see https://novita.ai
# MINIMAX_API_KEY=your-minimax-api-key  # OpenAI-compatible, see https://platform.minimax.io
# FEISHU_APP_ID=your-feishu-app-id
# FEISHU_APP_SECRET=your-feishu-app-secret
#
# Shared secret for proactive Feishu push (POST /api/channels/feishu/push). Optional if unused.
# Generate e.g. python -c "import secrets; print(secrets.token_urlsafe(32))"
# EVOFLOW_FEISHU_PUSH_SECRET=
#
# Gateway loads ``~/.evoflow/tasks/automations/*.toml`` by default (automation_runner). Override: EVOFLOW_AUTOMATIONS_DIR.
# EVOFLOW_AUTOMATION_SCHEDULER=0
# Optional tick interval (seconds, default 30): EVOFLOW_AUTOMATION_TICK_SECONDS=30
# When TOML has ``langgraph_run = true``, Gateway calls LangGraph ``runs.wait`` (default URL EVOFLOW_LANGGRAPH_URL):
# EVOFLOW_AUTOMATION_LANGGRAPH_TIMEOUT=600
# Graph super-step cap for automation only (default 800, max 3000). Not equal to tool-call count.
# EVOFLOW_AUTOMATION_LANGGRAPH_RECURSION_LIMIT=800
# Cron LangGraph: plan mode off by default (fewer graph super-steps). Enable with: EVOFLOW_AUTOMATION_PLAN_MODE=1
# EVOFLOW_AUTOMATION_LANGGRAPH_MAX_CONCURRENT=2
# Optional Feishu card link — replace {thread_id}; EvoPanel can read pending thread from sessionStorage on load:
# EVOFLOW_AUTOMATION_CHAT_LINK_TEMPLATE=http://127.0.0.1:1420/?thread={thread_id}

# Unattended task-center queue (auto plan/authorize/dispatch after POST /api/tasks).
# EVOFLOW_TASK_QUEUE_ENABLED=0
# EVOFLOW_TASK_QUEUE_MAX_CONCURRENT=3
# EVOFLOW_TASK_QUEUE_TICK_SECONDS=60
# EVOFLOW_TASK_QUEUE_RETRY_MAX=3
# EVOFLOW_TASK_QUEUE_RETRY_DELAYS=60,300,900
#
# Idle disk IO (optional; restart Gateway): stretch background cadence without disabling cleaners.
# EVOFLOW_ZOMBIE_SWEEP_INTERVAL_S=600
# EVOFLOW_WAL_CHECKPOINT_INTERVAL_S=7200
# EVOFLOW_OWNED_KB_POLL_S=5
# EVOFLOW_OWNED_KB_WORKER=0
# EVOFLOW_OWNED_KB_WORKER_STARTUP_DELAY_SEC=10
#
# Gateway startup (desktop cold start; defaults tuned for fast UI):
# EVOFLOW_STARTUP_TRACE=1
# Startup diagnostics (post-install troubleshooting):
#   ~/.evoflow/logs/gateway-startup.log     — structured [STARTUP-TRACE] timeline
#   ~/.evoflow/logs/gateway-YYYY-MM-DD.log  — full gateway log
#   ~/.evoflow/logs/evopanel-startup.log      — Tauri sidecar spawn (+xxx ms)
#   GET http://127.0.0.1:<port>/health/startup — JSON timeline + slowest gaps
#   Frontend console / frontend-*.log: search [BOOT]
# EVOFLOW_STARTUP_DB_PREFLIGHT=fast
# EVOFLOW_STARTUP_SKIP_OBS_PREFLIGHT=1
# EVOFLOW_STARTUP_DEFER_KB_WARMUP_SEC=5
# EVOFLOW_SKIP_LEAD_AGENT_STARTUP_WARMUP=1
# EVOFLOW_STARTUP_LG_SELFTEST=0
# EVOFLOW_PROJECT_CACHE_TTL=30
# EVOFLOW_LG_QUEUE_POLL_MS=50
# EVOFLOW_PROACTIVE_TICK_SECONDS=120
# EVOFLOW_LOG_FLUSH_INTERVAL_S=1
# Do not set EVOFLOW_DATA_RETENTION=0 unless you accept unbounded WAL growth.
#
# Browser automation: no built-in browser_* tools — enable skills/public/agent-browser and use terminal + agent-browser CLI.
# Install once: make setup-agent-browser
# Optional CDP: EVOFLOW_BROWSER_CDP_URL=http://127.0.0.1:9222
#
# Daily log files under ``logs/`` (``gateway-YYYY-MM-DD.log``, ``langgraph-YYYY-MM-DD.log``; 7-day retention):
# EVOFLOW_LOGS_DIR=/path/to/your/repo/logs
# EVOFLOW_LOG_RETENTION_DAYS=7
# EVOFLOW_GATEWAY_LOG_LEVEL=DEBUG

# SLACK_BOT_TOKEN=your-slack-bot-token
# SLACK_APP_TOKEN=your-slack-app-token
# TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# Enable LangSmith to monitor and debug your LLM calls, agent runs, and tool executions.
# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=your-langsmith-api-key
# LANGSMITH_PROJECT=your-langsmith-project

# LangGraph runtime isolation (multi-session concurrency):
# Each run gets its own event loop so chat stream and proactive wait do not starve
# each other on a shared Gateway loop.
# Default for in-process Gateway mount: EVOFLOW_FORCE_BG_JOB_ISOLATED_LOOPS=1
# (set in lazy_langgraph). Opt out with =0 to restore Windows shared-loop mode
# (may need EVOFLOW_CHAT_PREEMPT_PROACTIVE=1 as emergency only).
# EVOFLOW_FORCE_BG_JOB_ISOLATED_LOOPS=1
# BG_JOB_ISOLATED_LOOPS=true
#
# Cross-thread cancel of proactive when chat starts — OFF by default
# (never kill other sessions). Emergency only:
# EVOFLOW_CHAT_PREEMPT_PROACTIVE=1
#
# Concurrent background jobs per worker (langgraph dev defaults to 1 without this).
# scripts/serve.sh and scripts/dev-windows.ps1 pass --n-jobs-per-worker from this value (default 10).
# N_JOBS_PER_WORKER=10

# 后台异步 Mission State 分析器（额外 LLM）。0=关（默认与 harness 一致），1=开。
# EVOFLOW_MISSION_STATE_ENABLED=0

# 资产整理 Phase1：聊完后自动抽取偏好等到草稿箱（默认开，一般不用改）
# EVOFLOW_ASSET_PHASE1=1
# 资产整理 Phase2：把草稿合并进站立摘要 / 经验等（默认开）
# EVOFLOW_ASSET_PHASE2=1
# 软件启动时扫描未整理草稿并合并（默认开）
# EVOFLOW_ASSET_STARTUP_PHASE2=1
# 多久没被用到算「冷资产」（天）；也会清理已归档草稿
# EVOFLOW_ASSET_MAX_UNUSED_DAYS=90
# 对话内 query-recall 全文灌入（默认关）。
# EVOFLOW_QUERY_RECALL=0

# GitHub API Token
# GITHUB_TOKEN=your-github-token
