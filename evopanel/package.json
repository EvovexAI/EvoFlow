{
  "name": "evopanel",
  "version": "1.0.8",
  "private": true,
  "description": "EvoFlow — 面向长任务的原生 Agent Runtime 与控制平面（桌面端）",
  "type": "module",
  "author": "EvovexAI",
  "license": "SEE LICENSE IN ../LICENSE",
  "homepage": "https://www.evovexai.com",
  "repository": {
    "type": "git",
    "url": "https://github.com/EvovexAI/EvoFlow.git"
  },
  "bugs": {
    "url": "https://github.com/EvovexAI/EvoFlow/issues"
  },
  "keywords": [
    "evopanel",
    "ai-agent",
    "tauri",
    "desktop-app",
    "management-panel"
  ],
  "scripts": {
    "dev": "vite",
    "dev:tauri": "node scripts/run-platform-script.js dev",
    "build": "vite build",
    "build:tauri": "node scripts/run-platform-script.js build",
    "build:desktop:win": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/build.ps1",
    "build:desktop:mac": "bash ./scripts/build-installer-mac.sh",
    "build:debug": "node scripts/run-platform-script.js build --debug",
    "build:clean": "node scripts/run-platform-script.js build --clean",
    "package": "node scripts/run-platform-script.js package",
    "package:exe": "node scripts/run-platform-script.js package --exe-only",
    "package:all": "node scripts/run-platform-script.js package --both",
    "serve": "node scripts/serve.js",
    "serve:win": "powershell -ExecutionPolicy Bypass -File ./scripts/serve.ps1",
    "preview": "vite preview",
    "tauri": "node ./node_modules/@tauri-apps/cli/tauri.js",
    "icon:round": "python scripts/round-app-icon.py docs/assets/evoflow-app-icon-square.png docs/assets/evoflow-app-icon.png",
    "icon:regen": "npm run icon:round && node ./node_modules/@tauri-apps/cli/tauri.js icon docs/assets/evoflow-app-icon.png -o src-tauri/icons",
    "icon:generate": "npm run icon:regen && node -e \"require('fs').copyFileSync('src-tauri/icons/icon.ico','public/favicon.ico')\"",
    "version": "node scripts/sync-version.js",
    "version:sync": "node scripts/sync-version.js",
    "version:set": "node scripts/sync-version.js",
    "version:from-git": "node scripts/sync-version.js --from-git",
    "prebuild:desktop:win": "node scripts/sync-version.js && node scripts/download-kws-model.js && node scripts/ensure-kws-bundle.js",
    "prebuild:desktop:mac": "node scripts/sync-version.js && node scripts/download-kws-model.js && node scripts/ensure-kws-bundle.js",
    "kws:download": "node scripts/download-kws-model.js",
    "kws:ensure": "node scripts/ensure-kws-bundle.js",
    "test": "vitest run",
    "lint:font-size": "node scripts/check-font-size-tokens.mjs",
    "lint:font-size:strict": "node scripts/check-font-size-tokens.mjs --strict",
    "test:perf": "vitest run tests/client-perf.test.js tests/client-perf-scenarios.test.js tests/live-stream-path.test.js",
    "verify:perf": "node scripts/verify-perf.mjs",
    "verify:perf:stress": "node scripts/verify-perf.mjs --stress",
    "verify:perf:browser": "playwright test e2e/stream-perf.spec.js",
    "verify:perf:offline": "node scripts/verify-perf.mjs --offline",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "dev:web": "vite",
    "typecheck": "tsc --noEmit",
    "deps:ci": "npm ci --progress=true --loglevel verbose"
  },
  "dependencies": {
    "@ag-ui/core": "^0.0.57",
    "@aiden0z/pptx-renderer": "1.2.4",
    "@dnd-kit/core": "^6.3.1",
