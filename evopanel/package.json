    "browserslist": "^4.28.2",
    "caniuse-lite": "^1.0.30001784",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "happy-dom": "^20.8.9",
    "istanbul-lib-coverage": "^3.2.2",
