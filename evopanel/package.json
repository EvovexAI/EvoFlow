    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-jsx-parser": "^2.4.1",
    "react-pdf": "^10.4.1",
    "react-resizable-panels": "^4.10.0",
    "recharts": "^3.8.0",
    "remark-cjk-friendly-gfm-strikethrough": "^2.0.1",
    "shadcn": "4.1.1",
    "shiki": "^4.0.2",
    "smol-toml": "^1.9.0",
    "streamdown": "^2.5.0",
    "swr": "^2.5.1",
    "tailwind-merge": "^3.6.0",
    "tailwind-scrollbar-hide": "^4.0.0",
    "tailwindcss": "^4.3.1",
