    "docx-preview": "^0.4.0",
    "dompurify": "^3.4.1",
    "embla-carousel-react": "^8.6.0",
    "highlight.js": "^11.11.1",
    "ignore": "^7.0.12",
    "katex": "^0.19.0",
    "lexical": "^0.42.0",
    "lucide-react": "^1.18.0",
