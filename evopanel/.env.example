# 默认 #/chat 为 React；若需整站回退经典实现，设为 0 或 false
# VITE_USE_REACT_CHAT=0

# Desktop pack mode（与安装包一致）：不要设 EVOFLOW_GATEWAY_URL。
# 仅 PORT 表示 sidecar 优先绑定端口；设了 URL 才会跳过自启、改走外部 Gateway。
# EVOFLOW_GATEWAY_PORT=8070
# EVOPANEL_BACKEND_PORT=8070

# Web / -ExternalGateway（独立 uvicorn + 嘴替）时再打开：
# EVOFLOW_GATEWAY_URL=http://127.0.0.1:8070
# EVOFLOW_GATEWAY_PORT=8070
# VITE_EVOFLOW_GATEWAY_URL=http://127.0.0.1:8070
# VITE_EVOFLOW_GATEWAY_PORT=8070
