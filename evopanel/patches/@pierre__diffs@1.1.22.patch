diff --git a/dist/utils/splitFileContents.js b/dist/utils/splitFileContents.js
index 07fe419..102fc57 100644
--- a/dist/utils/splitFileContents.js
+++ b/dist/utils/splitFileContents.js
@@ -9,7 +9,19 @@ import { SPLIT_WITH_NEWLINES } from "../constants.js";
 * @returns Array of lines with newlines preserved
 */
 function splitFileContents(contents) {
-	return contents !== "" ? contents.split(SPLIT_WITH_NEWLINES) : [];
+	if (contents === "") return [];
+	if (SPLIT_WITH_NEWLINES != null) return contents.split(SPLIT_WITH_NEWLINES);
+	// Keeps trailing newlines on each line - same as split(/(?<=\\n)/).
+	const lines = [];
+	let lineStart = 0;
+	for (let i = 0; i < contents.length; i++) {
+		if (contents.charCodeAt(i) === 10 /* \n */) {
+			lines.push(contents.slice(lineStart, i + 1));
+			lineStart = i + 1;
+		}
+	}
+	if (lineStart < contents.length) lines.push(contents.slice(lineStart));
+	return lines;
 }
 
