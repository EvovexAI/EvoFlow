# Copy to:  scripts/maintainer/windows/local-publish.env  (same folder; that file is gitignored)
# UTF-8. No spaces around '='. Lines starting with # are ignored.
# Optional: set EVOFLOW_LOCAL_PUBLISH_ENV to an absolute path to use another file instead.

# --- Public repo sync (-SyncPublic): SSH + remote URL ---
# Use a deploy key / machine-user key registered on EvovexAI/EvoFlow ONLY — not your evolvear personal key.
EVOFLOW_PUBLIC_REPO_SSH_KEY=C:/Users/YOU/.ssh/id_ed25519_evovex_public

# Optional: override clone/push URL (default https://github.com/EvovexAI/EvoFlow.git; use git@ only if your global gitconfig does not break insteadOf)
#EVOFLOW_PUBLIC_GIT_URL=git@github.com:EvovexAI/EvoFlow.git

# Author shown on public mirror commits (must be EvovexAI org identity — not evolvear / personal account).
# GitHub → EvovexAI org → Settings → profile, or use org noreply: ID+evovexai@users.noreply.github.com
EVOFLOW_PUBLIC_GIT_USER_NAME=EvovexAI
EVOFLOW_PUBLIC_GIT_USER_EMAIL=evovexai@users.noreply.github.com

# --- Website static deploy (-DeployWebsiteTos): Volcano Engine TOS ---
# Same names as website/apps/web/scripts/deploy-tos.mjs and .github/workflows/deploy-site-tos.yml
TOS_ACCESS_KEY_ID=
TOS_SECRET_ACCESS_KEY=
TOS_ENDPOINT=https://tos-cn-beijing.volces.com
TOS_REGION=cn-beijing
TOS_BUCKET=
# Optional prefix (no leading slash)
#TOS_PREFIX=
# Set to 1 to list uploads only
#TOS_DRY_RUN=

# Aliases accepted by deploy-tos.mjs (optional; if set, can replace TOS_* AK/SK)
#VOLC_ACCESS_KEY_ID=
#VOLC_SECRET_ACCESS_KEY=

# --- Desktop build (-BuildDesktopInstaller): optional clean npm install ---
# Default: skip npm ci if evopanel/node_modules already has @tauri-apps/cli (faster; avoids Windows EPERM on esbuild).
# Set to 1 to always run npm ci in evopanel before build (closer to CI).
#EVOFLOW_INSTALL_NPM_DEPS=1

# --- GitHub Release (-CreatePublicGhRelease): gh CLI and/or token ---
# User-facing release description: edit scripts/maintainer/windows/public-release-body.txt (UTF-8).
# Prefer: install GitHub CLI (https://cli.github.com/) — script also checks Program Files / LocalAppData for gh.exe.
# If gh is not on PATH: set a classic PAT or fine-grained token (Contents + Releases for EvovexAI/EvoFlow):
#GITHUB_TOKEN=
# (GH_TOKEN is accepted as an alias.)
# Same PAT can be stored in GitHub as secret PUBLIC_REPO_GH_TOKEN so Actions (e.g. release-windows-desktop.yml)
# can run `gh release upload` to EvovexAI/EvoFlow — GITHUB_TOKEN only covers the repo that triggered the workflow.
#
# Optional: mirror desktop installers to Gitee Releases (attach_files API, NOT git LFS):
#GITEE_REPO_TOKEN=
#GITEE_OWNER=evovexai
#GITEE_REPO=EvoFlow
# Optional soft limit for a single Gitee attach (default 100 MB):
#GITEE_RELEASE_MAX_MB=100
#
# After each new public Release, older semver releases are deleted (release + tag). Default: keep 2.
#EVOFLOW_PUBLIC_RELEASE_KEEP_COUNT=2

# --- Optional: other object storage (e.g. Tencent COS) ---
# Wire these when/if you add a local deploy script; not read by local-publish.ps1 today.
#COS_SECRET_ID=
#COS_SECRET_KEY=
#COS_REGION=
#COS_BUCKET=
