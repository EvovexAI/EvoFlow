{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evoflow.local/schemas/organization-pack.schema.json",
  "title": "EvoFlow Organization Pack Manifest v1",
  "description": "Top-level pluggable bundle: primitives (agents/skills/mcp/vaults/extensions) + orchestration (team/pipelines/workspace).",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "kind", "id", "name", "version", "primitives"],
  "properties": {
    "schema": {
      "const": 1,
      "description": "Manifest schema version"
    },
    "kind": {
      "type": "string",
      "enum": ["team", "pipeline", "full"],
      "description": "team = employees only; pipeline = apps only; full = both"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,63}$",
      "description": "Stable organization pack id (kebab-case)"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "description": "Semver string, e.g. 1.0.0"
    },
    "description": {
      "type": "string",
      "maxLength": 500
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "description": "EvoFlow platform version range, e.g. >=0.8.0"
        },
        "node": {
          "type": "string",
          "description": "Node.js version range for extension sidecars"
        }
      }
    },
    "install": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id_prefix": {
          "type": "string",
          "pattern": "^[a-z0-9-]*$",
          "description": "Prefix added to agent_code / vault id on install to avoid conflicts"
        },
        "conflict_policy": {
          "type": "string",
          "enum": ["fail", "skip", "replace"],
          "default": "fail"
        },
        "merge_policy": {
          "type": "string",
          "enum": ["skip_existing", "overwrite", "skip_user_modified"],
          "default": "skip_existing",
          "description": "Upgrade merge behavior (Phase 2)"
        }
      }
    },
    "workspace": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "template": {
          "type": "string",
          "description": "Relative path to workspace template directory inside the pack"
        },
        "name": {
          "type": "string",
          "maxLength": 80,
          "description": "Display name for the workspace"
        },
        "path": {
          "type": "string",
          "description": "Fixed workspace path; if omitted, user chooses at install time"
        },
        "create_if_missing": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "primitives": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "agents": {
          "type": "array",
          "items": { "$ref": "#/$defs/agentRef" }
        },
        "skills": {
          "type": "array",
          "items": { "$ref": "#/$defs/skillRef" }
        },
        "mcp": {
          "type": "array",
          "items": { "$ref": "#/$defs/mcpRef" }
        },
        "vaults": {
          "type": "array",
          "items": { "$ref": "#/$defs/vaultRef" }
        },
        "extensions": {
          "type": "array",
          "items": { "$ref": "#/$defs/extensionRef" }
        }
      }
    },
    "team": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "employees": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/employeeRef" }
        }
      }
    },
    "pipelines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "apps": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/appRef" }
        }
      }
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "author": { "type": "string" },
        "license": { "type": "string" },
        "tags": {
          "type": "array",
          "items": { "type": "string" },
          "uniqueItems": true
        },
        "homepage": { "type": "string", "format": "uri" },
        "icon": { "type": "string" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "team" } } },
      "then": { "required": ["team"] }
    },
    {
      "if": { "properties": { "kind": { "const": "pipeline" } } },
      "then": { "required": ["pipelines"] }
    },
    {
      "if": { "properties": { "kind": { "const": "full" } } },
      "then": { "required": ["team", "pipelines"] }
    }
  ],
  "$defs": {
    "agentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string",
          "description": "Relative path to agent YAML definition"
        },
        "id_override": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$",
          "description": "Override agent_code after install"
        }
      }
    },
    "skillRef": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["path"],
          "properties": {
            "path": {
              "type": "string",
              "description": "Relative path to skill folder containing SKILL.md"
            }
          }
        },
        {
          "required": ["slug"],
          "properties": {
            "slug": {
              "type": "string",
              "description": "SkillHub slug to download at install time (Phase 2)"
            }
          }
        }
      ]
    },
    "mcpRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["from"],
      "properties": {
        "from": {
          "type": "string",
          "description": "Relative path to MCP config JSON or mcp.template.json"
        },
        "resolve_vars": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "description": "Variable substitutions, e.g. PLUGIN_ROOT -> ${ORG_ROOT}/extensions/foo/standalone"
        },
        "skip_if_exists": {
          "type": "boolean",
          "default": true,
          "description": "Skip registration if an MCP server with the same id is already enabled. Prevents overwriting user-customized MCP config."
        }
      }
    },
    "vaultRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "import"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{1,63}$"
        },
        "name": { "type": "string", "maxLength": 80 },
        "import": {
          "type": "string",
          "description": "Relative path to vault snapshot directory (Obsidian format) inside the pack"
        },
        "read_only": {
          "type": "boolean",
          "default": false
        },
        "export_excluded": {
          "type": "boolean",
          "default": true,
          "description": "When true (default), 'evoflow org export' omits vault data. Set false only for curated public knowledge."
        }
      }
    },
    "extensionRef": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["ref"],
          "properties": {
            "ref": {
              "type": "string",
              "description": "Relative path to directory containing evoflow.extension.json"
            },
            "link": {
              "type": "boolean",
              "default": false,
              "description": "true = register path only, do not copy (monorepo dev)"
            }
          }
        },
        {
          "required": ["suite"],
          "properties": {
            "suite": {
              "type": "string",
              "description": "Install an existing evoflow.suite.json by id (must be bundled)"
            }
          }
        }
      ]
    },
    "employeeRef": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["from"],
          "properties": {
            "from": {
              "type": "string",
              "description": "Relative path to employee JSON definition"
            }
          }
        },
        {
          "required": ["agent_code", "role_name"],
          "properties": {
            "agent_code": { "type": "string" },
            "role_name": { "type": "string" },
            "position_code": { "type": "string" },
            "department": { "type": "string" },
            "reports_to": { "type": "string" },
            "config": { "$ref": "#/$defs/employeeConfig" }
          }
        }
      ]
    },
    "employeeConfig": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "workspace_path": { "type": "string" },
        "knowledge_vault_ids": {
          "type": "array",
          "items": { "type": "string" }
        },
        "skills": {
          "type": "array",
          "items": { "type": "string" }
        },
        "tool_groups": {
          "type": "array",
          "items": { "type": "string" }
        },
        "autonomy_level": {
          "type": "string",
          "enum": ["full_auto", "approval_for_risky", "approval_for_all"]
        },
        "schedule": {
          "type": "string",
          "description": "iCal RRULE string"
        },
        "budget_daily_usd": { "type": "number", "minimum": 0 }
      }
    },
    "appRef": {
      "type": "object",
      "additionalProperties": false,
      "oneOf": [
        {
          "required": ["from"],
          "properties": {
            "from": {
              "type": "string",
              "description": "Relative path to app JSON (CreateAppRequest shape)"
            }
          }
        },
        {
          "required": ["name", "steps"],
          "properties": {
            "name": { "type": "string" },
            "description": { "type": "string" },
            "icon": { "type": "string" },
            "category": { "type": "string" },
            "execution_mode": {
              "type": "string",
              "enum": ["workflow", "lead_supervised"]
            },
            "parameters": {
              "type": "array",
              "items": { "type": "object" }
            },
            "steps": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "object" }
            },
            "tags": {
              "type": "array",
              "items": { "type": "string" }
            }
          }
        }
      ]
    }
  }
}
